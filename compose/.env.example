# Copy to `.env` (gitignored) and fill in real values.
#   cp infra/compose/.env.example infra/compose/.env
# Docker Compose loads infra/compose/.env automatically.

# --- Local auth (HS256). REQUIRED, >= 32 bytes - compose refuses to start without it. Generate a fresh one:
#     PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=ecommerce-auth

# --- Payment demo behaviour
PAYMENT_AUTO_DECLINE_ABOVE_CENTS=500000

# --- Web client origins allowed through CORS (future frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- "Sign in with Microsoft 365" (optional). Leave BLANK to run with no Azure
#     dependency. Fill in after registering an app in Entra ID (see RUNBOOK).
ENTRA_ISSUER_URI=
ENTRA_CLIENT_ID=

# --- PostgreSQL overlay (docker-compose.postgres.yml). Password is REQUIRED.
POSTGRES_USER=ecom
POSTGRES_PASSWORD=
